# Core Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database
# Local development can keep USE_SQLITE=True.
# For Cloud Run production set USE_SQLITE=False and fill the PostgreSQL values below.
USE_SQLITE=True
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
# Optional alternative to the individual DB_* values:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# If using Cloud SQL Unix sockets on Cloud Run:
# INSTANCE_CONNECTION_NAME=project-id:region:instance-name

# Security / proxy
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Static / media
STATIC_URL=/static/
MEDIA_URL=/media/
MEDIA_ROOT=media
# Optional Cloudinary media storage
CLOUDINARY_STORAGE_ENABLED=False
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Existing app secrets
OPENAI_API_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=
SOCIAL_AUTH_APPLE_ID_CLIENT=
SOCIAL_AUTH_APPLE_ID_TEAM=
SOCIAL_AUTH_APPLE_ID_KEY=
SOCIAL_AUTH_APPLE_ID_SECRET=

# Donation / content extras
DONATION_UPI_ID=
DONATION_PAYEE_NAME=
DONATION_QR_URL=
