# Core Django
SECRET_KEY=change-me
DEBUG=True
# DEBUG defaults to False; set True only for local development.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database (MongoDB)
# Use your Atlas / replica-set connection string. Never commit the real value.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sms_website

# Security / proxy
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Static / media
STATIC_URL=/static/
MEDIA_URL=/media/
MEDIA_ROOT=media
# Optional Cloudinary media storage
CLOUDINARY_STORAGE_ENABLED=False
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Existing app secrets
OPENAI_API_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=
SOCIAL_AUTH_APPLE_ID_CLIENT=
SOCIAL_AUTH_APPLE_ID_TEAM=
SOCIAL_AUTH_APPLE_ID_KEY=
SOCIAL_AUTH_APPLE_ID_SECRET=

# Donation / content extras
DONATION_UPI_ID=
DONATION_PAYEE_NAME=
DONATION_QR_URL=

# Password reset emails (SMTP). In DEBUG the link is printed to the server console instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Placeholder wallet top-up (credits money WITHOUT payment). Leave False in production.
WALLET_DEV_RECHARGE_ENABLED=False

# --- Library books from Google Drive -------------------------------------------------------------------------------------------
# Folder layout:  <this folder>/<Collection>/<Book>.pdf   (deeper folders group books; new folders and PDFs appear automatically)
# Covers: a book's cover is its first page. To choose your own, put a picture with the same name next to the PDF (agni-puran.jpg).
# Paste the folder id or the whole share link.
LIBRARY_DRIVE_FOLDER_ID=
# How the site reads it. Leave both empty if the folder is shared as "Anyone with the link" (works with no key).
# Or: an API key (Drive API enabled), or a service account whose e-mail you shared the folder with (folder can stay private).
GOOGLE_DRIVE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
# How often (seconds) the folder is re-read, and how the PDF opens: "proxy" (through the site) or "preview" (Google's viewer).
LIBRARY_DRIVE_TTL=600
LIBRARY_PDF_VIEWER=proxy
# Development only: read the same layout from a local folder instead of Drive.
LIBRARY_LOCAL_DIR=
# Books are cached on disk after their first read (oldest evicted first). Defaults: system temp folder, 1500 MB.
LIBRARY_CACHE_DIR=
LIBRARY_CACHE_MAX_MB=1500
